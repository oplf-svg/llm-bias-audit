*.py[cod]
.venv/
venv/
env/
.env
.env.local
.env.*.local
*.egg-info/
build/
dist/

# ==============================================================
# Secrets & credentials  (never commit any of these)
# ==============================================================
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.*
secrets.*
secrets/
.secrets/
.aws/
.gcloud/
huggingface_token*
hf_token*
.hf_token
**/*.env.local

# ==============================================================
# Personal data  (signatures, IDs, contact details)
# ==============================================================
signature*.png
signature*.jpg
signature*.jpeg
*_signature.*
personal_info.*
AUTHOR.local.md

# ==============================================================
# Results (large, regenerated from code + seed)
# ==============================================================
results/*.json
results/*.jsonl
results/*.parquet
results/*.csv
results/figures/
results/tables/
results/full/
results/pilot/
results/determinism_check/
!results/.gitkeep

